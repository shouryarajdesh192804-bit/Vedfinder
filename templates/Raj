<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini 3D Craft - Rivers, Lava & Water Added</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background-color: #73C2FB;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            user-select: none;
        }
        #hud {
            position: absolute;
            top: 20px;
            left: 20px;
            color: white;
            font-size: 16px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.9);
            pointer-events: none;
            background: rgba(0,0,0,0.5);
            padding: 15px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.2);
        }
        #hud h2 {
            margin: 0 0 5px 0;
            color: #FFD700;
        }
        .stat-bar {
            width: 180px;
            height: 12px;
            background: rgba(255,255,255,0.2);
            border-radius: 6px;
            overflow: hidden;
            display: inline-block;
            vertical-align: middle;
            margin-left: 5px;
        }
        .stat-fill {
            height: 100%;
            width: 100%;
            transition: width 0.2s ease;
        }
        #hungerFill { background: #FF8C00; }
        #staminaFill { background: #00BFFF; }
        #crosshair {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 12px;
            height: 12px;
            margin-left: -6px;
            margin-top: -6px;
            border: 2px solid rgba(255,255,255,0.8);
            border-radius: 50%;
            pointer-events: none;
        }
        #hotbar {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            background: rgba(0,0,0,0.7);
            padding: 10px;
            border-radius: 10px;
            border: 2px solid #555;
            pointer-events: auto;
            z-index: 5;
        }
        .slot {
            width: 55px;
            height: 55px;
            border: 2px solid #777;
            background: rgba(255,255,255,0.1);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 11px;
            border-radius: 6px;
            text-align: center;
            cursor: pointer;
            transition: all 0.1s;
        }
        .slot:hover {
            border-color: #FFF;
            background: rgba(255,255,255,0.2);
        }
        .slot.active {
            border-color: #FFD700;
            background: rgba(255,215,0,0.3);
        }
        #inventoryScreen {
            display: none;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 500px;
            background: rgba(25, 25, 25, 0.95);
            border: 3px solid #FFD700;
            border-radius: 12px;
            padding: 20px;
            color: white;
            box-shadow: 0 0 40px rgba(0,0,0,0.9);
            z-index: 100;
            pointer-events: auto;
        }
        #inventoryScreen h3 {
            margin-top: 0;
            text-align: center;
            color: #FFD700;
        }
        .inv-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-top: 15px;
        }
        .inv-slot {
            height: 75px;
            background: rgba(255,255,255,0.1);
            border: 2px solid #555;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .inv-slot:hover {
            border-color: #FFD700;
            background: rgba(255,215,0,0.25);
            transform: scale(1.03);
        }
        .inv-slot.selected {
            border-color: #00FF00;
            background: rgba(0,255,0,0.3);
        }
        #selectionInfo {
            background: rgba(0,0,0,0.5);
            padding: 8px;
            border-radius: 6px;
            text-align: center;
            margin-bottom: 10px;
            font-size: 13px;
            color: #00FF00;
            border: 1px solid rgba(0,255,0,0.3);
        }
        #cheatPrompt {
            display: none;
            position: absolute;
            bottom: 90px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.85);
            padding: 10px 20px;
            border: 2px solid #FFD700;
            border-radius: 8px;
            color: white;
            font-size: 18px;
            z-index: 100;
        }
        #cheatInput {
            background: transparent;
            border: none;
            color: #FFD700;
            font-size: 18px;
            outline: none;
            font-family: inherit;
        }
        #conclusionScreen {
            display: none;
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.85);
            z-index: 1000;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
        }
        #conclusionScreen h1 {
            color: #FFD700;
            font-size: 48px;
            margin-bottom: 10px;
            text-shadow: 0 0 20px rgba(255,215,0,0.8);
        }
        #conclusionScreen p {
            font-size: 20px;
            color: #ddd;
            max-width: 600px;
            line-height: 1.5;
        }
        .conclusion-btn {
            margin-top: 30px;
            padding: 12px 30px;
            background: #FFD700;
            color: #111;
            font-weight: bold;
            font-size: 18px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 0 15px rgba(255,215,0,0.5);
            transition: transform 0.2s;
        }
        .conclusion-btn:hover {
            transform: scale(1.05);
            background: #ffea70;
        }
    </style>
</head>
<body>

    <div id="hud">
        <h2>⛏️ CLASSIC MINECRAFT FOREST 🌳</h2>
        <p>Level: <span id="levelDisplay">1</span> | XP: <span id="xpDisplay">0</span> / 100 | Time: <span id="timeDisplay">Day</span></p>
        <p>Hunger: <div class="stat-bar"><div class="stat-fill" id="hungerFill"></div></div></p>
        <p style="margin-top: 6px;">Stamina: <div class="stat-bar"><div class="stat-fill" id="staminaFill"></div></div></p>
        <p style="font-size: 13px; color: #aaa; margin:8px 0 0 0;">
            <b>Click screen</b> to look | <b>WASD</b> Move | <b>Space</b> Jump | <b>Q</b> Drink Water<br>
            <b>Left Alt</b>: Mine / Attack Hunt / Open Chest | <b>Right Alt</b>: Place Block<br>
            <b>E</b>: Inventory | <b>T</b>: Day/Night | <b>Keys 1-6</b>: Hotbar Select<br>
            <i>Commands (Enter):</i> <b>reverse</b>, <b>lava reverse</b>, <b>fly</b>, <b>god</b>, <b>torch</b>
        </p>
    </div>

    <div id="crosshair"></div>

    <div id="cheatPrompt">
        <span>Cheat / Command: </span><input type="text" id="cheatInput" placeholder="type reverse or lava reverse...">
    </div>

    <div id="inventoryScreen">
        <h3>🎒 ALL BLOCKS & INVENTORY MANAGER</h3>
        <div id="selectionInfo">Click an item in your inventory, then click a Hotbar slot below to assign it!</div>
        <div class="inv-grid" id="invGridContainer"></div>
        <p style="font-size: 12px; text-align: center; margin-top: 15px; color: #888;">Press <b>E</b> to close inventory and resume game</p>
    </div>

    <div id="conclusionScreen">
        <h1>🌟 MASTER CRAFTER VICTORY! 🌟</h1>
        <p>Congratulations! You have successfully gathered resources, hunted, explored rivers, and reached <b>Level 5</b>!</p>
        <p style="color: #00FF00; margin-top: 10px;">Your world is fully built, mastered, and conquered.</p>
        <button class="conclusion-btn" onclick="closeConclusion()">Continue Freeplay</button>
    </div>

    <div id="hotbar">
        <div class="slot active" id="hbSlot0" onclick="onHotbarSlotClick(0)">
            <span class="hb-name" id="hbName0">Pickaxe</span>
            <span class="hb-count" id="hbCount0" style="color:#FFD700; font-size:10px;">x1</span>
        </div>
        <div class="slot" id="hbSlot1" onclick="onHotbarSlotClick(1)">
            <span class="hb-name" id="hbName1">Sword</span>
            <span class="hb-count" id="hbCount1" style="color:#FFD700; font-size:10px;">x1</span>
        </div>
        <div class="slot" id="hbSlot2" onclick="onHotbarSlotClick(2)">
            <span class="hb-name" id="hbName2">Wood</span>
            <span class="hb-count" id="hbCount2" style="color:#FFD700; font-size:10px;">x16</span>
        </div>
        <div class="slot" id="hbSlot3" onclick="onHotbarSlotClick(3)">
            <span class="hb-name" id="hbName3">Stone</span>
            <span class="hb-count" id="hbCount3" style="color:#FFD700; font-size:10px;">x16</span>
        </div>
        <div class="slot" id="hbSlot4" onclick="onHotbarSlotClick(4)">
            <span class="hb-name" id="hbName4">Dirt</span>
            <span class="hb-count" id="hbCount4" style="color:#FFD700; font-size:10px;">x32</span>
        </div>
        <div class="slot" id="hbSlot5" onclick="onHotbarSlotClick(5)">
            <span class="hb-name" id="hbName5">Grass</span>
            <span class="hb-count" id="hbCount5" style="color:#FFD700; font-size:10px;">x32</span>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/PointerLockControls.js"></script>

    <script>
        let scene, camera, renderer, controls;
        let blocks = [];
        let animals = [];
        let chests = [];
        let heldItemMesh = null;
        let particles = [];
        let hasTriggeredConclusion = false;

        let moveForward = false, moveBackward = false, moveLeft = false, moveRight = false, canJump = false;
        let velocity = new THREE.Vector3();
        let prevTime = performance.now();

        let scoreXP = 0;
        let playerLevel = 1;
        let selectedSlotIndex = 0;
        let isFlying = false;
        let isNight = false;
        let isInventoryOpen = false;

        let hungerLevel = 100;
        let staminaLevel = 100;

        let ambientLight, sunLight;
        let blockTextures = [];

        const inventory = {
            Pickaxe: 1,
            Sword: 1,
            Wood: 32,
            Stone: 32,
            Dirt: 64,
            Grass: 64,
            Magma: 16,
            Leaves: 32,
            Wool: 16,
            Porkchop: 10
        };

        const hotbar = ["Pickaxe", "Sword", "Wood", "Stone", "Dirt", "Grass"];
        let selectedInventoryItem = null;

        function createPixelTexture(type) {
            const canvas = document.createElement('canvas');
            canvas.width = 16;
            canvas.height = 16;
            const ctx = canvas.getContext('2d');

            if (type === 'grass_top') {
                ctx.fillStyle = '#568b2e';
                ctx.fillRect(0, 0, 16, 16);
                for (let i = 0; i < 24; i++) {
                    ctx.fillStyle = Math.random() > 0.5 ? '#67a637' : '#457223';
                    ctx.fillRect(Math.floor(Math.random()*16), Math.floor(Math.random()*16), 1, 1);
                }
            } else if (type === 'dirt') {
                ctx.fillStyle = '#734d31';
                ctx.fillRect(0, 0, 16, 16);
                for (let i = 0; i < 30; i++) {
                    ctx.fillStyle = Math.random() > 0.5 ? '#5e3e26' : '#855938';
                    ctx.fillRect(Math.floor(Math.random()*16), Math.floor(Math.random()*16), 1, 1);
                }
            } else if (type === 'grass_side') {
                ctx.fillStyle = '#734d31';
                ctx.fillRect(0, 0, 16, 16);
                for (let i = 0; i < 25; i++) {
                    ctx.fillStyle = '#5e3e26';
                    ctx.fillRect(Math.floor(Math.random()*16), Math.floor(Math.random()*16), 1, 1);
                }
                const exactGrassHeights = [4, 4, 5, 5, 4, 6, 4, 5, 5, 4, 5, 4, 4, 5, 7, 8];
                for (let x = 0; x < 16; x++) {
                    let h = exactGrassHeights[x];
                    for (let y = 0; y < h; y++) {
                        ctx.fillStyle = '#568b2e';
                        ctx.fillRect(x, y, 1, 1);
                    }
                }
            } else if (type === 'stone') {
                ctx.fillStyle = '#7f8c8d';
                ctx.fillRect(0, 0, 16, 16);
                for (let i = 0; i < 30; i++) {
                    ctx.fillStyle = Math.random() > 0.5 ? '#6c7a89' : '#95a5a6';
                    ctx.fillRect(Math.floor(Math.random()*16), Math.floor(Math.random()*16), 1, 1);
                }
            } else if (type === 'magma') {
                ctx.fillStyle = '#d35400';
                ctx.fillRect(0, 0, 16, 16);
                for (let i = 0; i < 25; i++) {
                    ctx.fillStyle = '#f39c12';
                    ctx.fillRect(Math.floor(Math.random()*16), Math.floor(Math.random()*16), 2, 2);
                }
            } else if (type === 'water') {
                ctx.fillStyle = '#1e90ff';
                ctx.fillRect(0, 0, 16, 16);
                for (let i = 0; i < 20; i++) {
                    ctx.fillStyle = '#00bfff';
                    ctx.fillRect(Math.floor(Math.random()*16), Math.floor(Math.random()*16), 2, 2);
                }
            } else if (type === 'wood') {
                ctx.fillStyle = '#5c3a21';
                ctx.fillRect(0, 0, 16, 16);
                ctx.fillStyle = '#734a27';
                for (let y = 0; y < 16; y++) {
                    ctx.fillRect(2, y, 2, 1);
                    ctx.fillRect(8, y, 2, 1);
                    ctx.fillRect(13, y, 2, 1);
                }
            } else if (type === 'leaves') {
                ctx.fillStyle = '#3b7a32';
                ctx.fillRect(0, 0, 16, 16);
                for (let i = 0; i < 30; i++) {
                    ctx.fillStyle = Math.random() > 0.5 ? '#2e5e26' : '#4d9a42';
                    ctx.fillRect(Math.floor(Math.random()*16), Math.floor(Math.random()*16), 1, 1);
                }
            } else if (type === 'wool') {
                ctx.fillStyle = '#ecf0f1';
                ctx.fillRect(0, 0, 16, 16);
                for (let i = 0; i < 20; i++) {
                    ctx.fillStyle = '#bdc3c7';
                    ctx.fillRect(Math.floor(Math.random()*16), Math.floor(Math.random()*16), 2, 2);
                }
            }

            const texture = new THREE.CanvasTexture(canvas);
            texture.magFilter = THREE.NearestFilter;
            texture.minFilter = THREE.NearestFilter;
            return texture;
        }

        function initTextures() {
            blockTextures = [
                [
                    new THREE.MeshLambertMaterial({ map: createPixelTexture('grass_top') }),
                    new THREE.MeshLambertMaterial({ map: createPixelTexture('dirt') }),
                    new THREE.MeshLambertMaterial({ map: createPixelTexture('grass_side') }),
                    new THREE.MeshLambertMaterial({ map: createPixelTexture('grass_side') }),
                    new THREE.MeshLambertMaterial({ map: createPixelTexture('grass_side') }),
                    new THREE.MeshLambertMaterial({ map: createPixelTexture('grass_side') })
                ],
                new THREE.MeshLambertMaterial({ map: createPixelTexture('dirt') }),
                new THREE.MeshLambertMaterial({ map: createPixelTexture('stone') }),
                new THREE.MeshLambertMaterial({ map: createPixelTexture('magma'), emissive: 0xff3300 }),
                [
                    new THREE.MeshLambertMaterial({ map: createPixelTexture('dirt') }),
                    new THREE.MeshLambertMaterial({ map: createPixelTexture('dirt') }),
                    new THREE.MeshLambertMaterial({ map: createPixelTexture('wood') }),
                    new THREE.MeshLambertMaterial({ map: createPixelTexture('wood') }),
                    new THREE.MeshLambertMaterial({ map: createPixelTexture('wood') }),
                    new THREE.MeshLambertMaterial({ map: createPixelTexture('wood') })
                ],
                new THREE.MeshLambertMaterial({ map: createPixelTexture('leaves'), transparent: true }),
                new THREE.MeshLambertMaterial({ map: createPixelTexture('wool') }),
                new THREE.MeshLambertMaterial({ map: createPixelTexture('water'), transparent: true, opacity: 0.85 })
            ];
        }

        const boxGeo = new THREE.BoxGeometry(2, 2, 2);
        let raycaster = new THREE.Raycaster();
        let mouse = new THREE.Vector2(0, 0);

        init();
        animate();

        function init() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x73C2FB);
            scene.fog = new THREE.FogExp2(0x73C2FB, 0.005);

            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 14, 24);

            renderer = new THREE.WebGLRenderer({ antialias: false });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.shadowMap.enabled = true;
            document.body.appendChild(renderer.domElement);

            initTextures();

            controls = new THREE.PointerLockControls(camera, document.body);
            document.body.addEventListener('click', () => {
                if (!controls.isLocked && !isInventoryOpen && document.getElementById('cheatPrompt').style.display !== 'block' && document.getElementById('conclusionScreen').style.display !== 'flex') {
                    controls.lock();
                }
            });
            scene.add(controls.getObject());

            ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
            scene.add(ambientLight);

            sunLight = new THREE.DirectionalLight(0xffffff, 0.7);
            sunLight.position.set(60, 140, 60);
            scene.add(sunLight);

            // Generate Terrain with Rivers (Water & Lava Rivers)
            for (let x = -40; x <= 40; x += 2) {
                for (let z = -40; z <= 40; z += 2) {
                    let height = (Math.abs(x) <= 6 && Math.abs(z) <= 6) ? 1 : (Math.floor(Math.abs(Math.sin(x * 0.12) * Math.cos(z * 0.12)) * 6) + 2);
                    
                    // Create Water River channel across X axis
                    let isWaterRiver = (Math.abs(z - 10) <= 2 && x >= -30 && x <= 30);
                    // Create Lava River channel across Z axis
                    let isLavaRiver = (Math.abs(x + 12) <= 2 && z >= -30 && z <= 30);

                    if (isWaterRiver) {
                        createBlockAt(x, 2, z, 7); // Water block
                    } else if (isLavaRiver) {
                        createBlockAt(x, 2, z, 3); // Lava block
                    } else {
                        for (let y = 1; y <= height * 2; y += 2) {
                            let matIndex = (y === height * 2) ? 0 : (y > 4 ? 2 : 1);
                            createBlockAt(x, y, z, matIndex);
                        }
                    }
                }
            }

            createBonusChest(3, 3, 3);
            spawnDenseForest();
            spawnAnimals();
            createClassicClouds();
            createConclusionParticles();

            updateInventoryUI();
            updateHotbarUI();
            updateStatsUI();
            updateHeldItem();

            window.addEventListener('keydown', onKeyDown);
            window.addEventListener('keyup', onKeyUp);
            window.addEventListener('resize', onWindowResize);

            const cheatInput = document.getElementById('cheatInput');
            cheatInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    executeCheat(cheatInput.value.trim().toLowerCase());
                    cheatInput.value = '';
                    document.getElementById('cheatPrompt').style.display = 'none';
                    controls.lock();
                }
            });
        }

        function createConclusionParticles() {
            const particleGeo = new THREE.BoxGeometry(0.4, 0.4, 0.4);
            const particleMat = new THREE.MeshBasicMaterial({ color: 0xFFD700 });
            for (let i = 0; i < 50; i++) {
                const p = new THREE.Mesh(particleGeo, particleMat);
                p.position.set((Math.random() - 0.5) * 60, Math.random() * 30 + 10, (Math.random() - 0.5) * 60);
                p.userData = { speedY: Math.random() * 0.1 + 0.05, rotSpeed: Math.random() * 0.1 };
                scene.add(p);
                particles.push(p);
            }
        }

        function triggerConclusion() {
            if (hasTriggeredConclusion) return;
            hasTriggeredConclusion = true;
            if (controls.isLocked) controls.unlock();
            document.getElementById('conclusionScreen').style.display = 'flex';
        }

        function closeConclusion() {
            document.getElementById('conclusionScreen').style.display = 'none';
            controls.lock();
        }

        function createBonusChest(x, y, z) {
            const chestGeo = new THREE.BoxGeometry(1.6, 1.2, 1.6);
            const chestMat = new THREE.MeshLambertMaterial({ map: createPixelTexture('wood') });
            const chest = new THREE.Mesh(chestGeo, chestMat);
            chest.position.set(x, y + 0.6, z);
            chest.userData = { opened: false };
            scene.add(chest);
            chests.push(chest);
        }

        function spawnDenseForest() {
            for (let x = -32; x <= 32; x += 8) {
                for (let z = -32; z <= 32; z += 8) {
                    if (Math.abs(x) > 4 || Math.abs(z) > 4) {
                        if (Math.random() > 0.3) {
                            let groundHeight = (Math.floor(Math.abs(Math.sin(x * 0.12) * Math.cos(z * 0.12)) * 6) + 2) * 2 + 1;
                            createClassicTree(x + (Math.random() - 0.5) * 2, groundHeight, z + (Math.random() - 0.5) * 2);
                        }
                    }
                }
            }
        }

        function createClassicTree(x, y, z) {
            for (let ty = 0; ty < 8; ty += 2) {
                createBlockAt(x, y + ty, z, 4);
            }
            for (let lx = -2; lx <= 2; lx += 2) {
                for (let lz = -2; lz <= 2; lz += 2) {
                    for (let ly = 6; ly <= 10; ly += 2) {
                        if (Math.abs(lx) === 2 && Math.abs(lz) === 2 && ly === 10) continue;
                        createBlockAt(x + lx, y + ly, z + lz, 5);
                    }
                }
            }
        }

        function createClassicClouds() {
            const cloudMat = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.85 });
            for (let i = 0; i < 15; i++) {
                const cloudGeo = new THREE.BoxGeometry(16, 2, 8);
                const cloud = new THREE.Mesh(cloudGeo, cloudMat);
                cloud.position.set((Math.random() - 0.5) * 200, 70 + Math.random() * 20, (Math.random() - 0.5) * 200);
                scene.add(cloud);
            }
        }

        function updateHeldItem() {
            if (heldItemMesh) {
                camera.remove(heldItemMesh);
                heldItemMesh = null;
            }

            const current = hotbar[selectedSlotIndex];

            if (current === 'Pickaxe') {
                heldItemMesh = new THREE.Group();
                const handleMat = new THREE.MeshLambertMaterial({ color: 0x8b5a2b });
                const headMat = new THREE.MeshLambertMaterial({ color: 0xb0c4de });

                const handle = new THREE.Mesh(new THREE.BoxGeometry(0.2, 1.2, 0.2), handleMat);
                handle.position.set(0, -0.2, 0);
                heldItemMesh.add(handle);

                const head = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.3, 0.2), headMat);
                head.position.set(0, 0.4, 0);
                heldItemMesh.add(head);

                heldItemMesh.position.set(0.6, -0.4, -0.8);
                heldItemMesh.rotation.z = Math.PI / 5;
            } else if (current === 'Sword') {
                heldItemMesh = new THREE.Group();
                const hiltMat = new THREE.MeshLambertMaterial({ color: 0x555555 });
                const bladeMat = new THREE.MeshLambertMaterial({ color: 0xe0e0e0 });

                const hilt = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.5, 0.2), hiltMat);
                hilt.position.set(0, -0.4, 0);
                heldItemMesh.add(hilt);

                const blade = new THREE.Mesh(new THREE.BoxGeometry(0.25, 1.3, 0.1), bladeMat);
                blade.position.set(0, 0.4, 0);
                heldItemMesh.add(blade);

                heldItemMesh.position.set(0.6, -0.4, -0.8);
                heldItemMesh.rotation.z = Math.PI / 6;
            } else {
                let matIndex = 0;
                if (current === 'Dirt') matIndex = 1;
                else if (current === 'Stone') matIndex = 2;
                else if (current === 'Magma') matIndex = 3;
                else if (current === 'Wood') matIndex = 4;
                else if (current === 'Leaves') matIndex = 5;
                else if (current === 'Wool') matIndex = 6;

                const geom = new THREE.BoxGeometry(0.5, 0.5, 0.5);
                const mat = Array.isArray(blockTextures[matIndex]) ? blockTextures[matIndex][0] : blockTextures[matIndex];
                heldItemMesh = new THREE.Mesh(geom, mat);
                heldItemMesh.position.set(0.6, -0.5, -0.9);
            }

            if (heldItemMesh) {
                camera.add(heldItemMesh);
            }
        }

        function updateInventoryUI() {
            const container = document.getElementById('invGridContainer');
            container.innerHTML = '';
            for (let key in inventory) {
                const slotDiv = document.createElement('div');
                slotDiv.className = 'inv-slot';
                if (selectedInventoryItem === key) slotDiv.classList.add('selected');
                
                slotDiv.innerHTML = `<b>${key}</b><span style="color:#FFD700; margin-top:4px;">x${inventory[key]}</span>`;
                
                slotDiv.onclick = (e) => {
                    e.stopPropagation();
                    if (key === 'Porkchop' && inventory['Porkchop'] > 0) {
                        inventory['Porkchop']--;
                        hungerLevel = Math.min(100, hungerLevel + 35);
                        updateStatsUI();
                        updateInventoryUI();
                        updateHotbarUI();
                        alert("🍗 Ate Raw Porkchop! Hunger restored.");
                    } else {
                        selectedInventoryItem = key;
                        document.getElementById('selectionInfo').innerText = `Selected: "${key}". Now click a Hotbar slot below!`;
                        updateInventoryUI();
                    }
                };
                container.appendChild(slotDiv);
            }
        }

        function updateHotbarUI() {
            for (let i = 0; i < 6; i++) {
                const itemName = hotbar[i];
                const count = inventory[itemName] !== undefined ? inventory[itemName] : '';
                document.getElementById(`hbName${i}`).innerText = itemName;
                document.getElementById(`hbCount${i}`).innerText = count !== '' ? `x${count}` : '';
            }
        }

        function onHotbarSlotClick(index) {
            if (isInventoryOpen && selectedInventoryItem) {
                hotbar[index] = selectedInventoryItem;
                selectedInventoryItem = null;
                document.getElementById('selectionInfo').innerText = `Assigned item to Hotbar slot ${index + 1}! Click another item or press E to close.`;
                updateInventoryUI();
                updateHotbarUI();
                updateHeldItem();
            } else {
                setHotbarSlot(index);
            }
        }

        function updateStatsUI() {
            document.getElementById('hungerFill').style.width = hungerLevel + '%';
            document.getElementById('staminaFill').style.width = staminaLevel + '%';
        }

        function drinkWater() {
            staminaLevel = 100;
            updateStatsUI();
            alert("💦 Stamina fully restored!");
        }

        function spawnAnimals() {
            for (let i = 0; i < 8; i++) {
                createPig((Math.random() - 0.5) * 40, 3, (Math.random() - 0.5) * 40);
            }
        }

        function createPig(x, y, z) {
            const group = new THREE.Group();
            const body = new THREE.Mesh(new THREE.BoxGeometry(1.6, 1.0, 2.2), new THREE.MeshLambertMaterial({ color: 0xFFB6C1 }));
            body.position.y = 0.5;
            group.add(body);
            group.position.set(x, y, z);
            group.userData = { type: 'pig', wanderSpeed: 1.0, angle: Math.random() * Math.PI * 2 };
            scene.add(group);
            animals.push(group);
        }

        function toggleDayNight() {
            isNight = !isNight;
            const timeDisplay = document.getElementById('timeDisplay');
            if (isNight) {
                scene.background.setHex(0x0B1D3A);
                scene.fog.color.setHex(0x0B1D3A);
                ambientLight.intensity = 0.2;
                sunLight.intensity = 0.1;
                timeDisplay.innerText = "Night 🌙";
            } else {
                scene.background.setHex(0x73C2FB);
                scene.fog.color.setHex(0x73C2FB);
                ambientLight.intensity = 0.8;
                sunLight.intensity = 0.7;
                timeDisplay.innerText = "Day ☀️";
            }
        }

        function toggleInventory() {
            isInventoryOpen = !isInventoryOpen;
            const invScreen = document.getElementById('inventoryScreen');
            if (isInventoryOpen) {
                if (controls.isLocked) controls.unlock();
                selectedInventoryItem = null;
                document.getElementById('selectionInfo').innerText = "Click an item in your inventory, then click a Hotbar slot below to assign it!";
                invScreen.style.display = 'block';
                updateInventoryUI();
            } else {
                invScreen.style.display = 'none';
            }
        }

        function createBlockAt(x, y, z, matIndex) {
            let material = blockTextures[matIndex];
            const block = new THREE.Mesh(boxGeo, material);
            block.position.set(x, y, z);
            scene.add(block);
            blocks.push(block);
            return block;
        }

        function addXP(amount) {
            scoreXP += amount;
            if (scoreXP >= 100) {
                scoreXP -= 100;
                playerLevel++;
                if (playerLevel >= 5) {
                    triggerConclusion();
                }
            }
            document.getElementById("levelDisplay").innerText = playerLevel;
            document.getElementById("xpDisplay").innerText = scoreXP;
        }

        function executeCheat(code) {
            const pos = controls.getObject().position;
            if (code === 'torch') {
                createBlockAt(Math.round(pos.x), Math.round(pos.y), Math.round(pos.z), 3);
            } else if (code === 'fly') {
                isFlying = !isFlying;
                alert("Flight Mode: " + (isFlying ? "ON" : "OFF"));
            } else if (code === 'god') {
                addXP(100);
                hungerLevel = 100;
                staminaLevel = 100;
                updateStatsUI();
                alert("God Mode Activated!");
            } else if (code === 'reverse') {
                controls.getObject().rotation.y += Math.PI;
                alert("🔄 Reverse Command Executed: Turned 180 degrees around!");
            } else if (code === 'lava reverse') {
                let countCleared = 0;
                blocks.forEach(b => {
                    if (b.material && b.material.emissive && b.material.emissive.getHex() === 0xff3300) {
                        scene.remove(b);
                        countCleared++;
                    }
                });
                blocks = blocks.filter(b => !(b.material && b.material.emissive && b.material.emissive.getHex() === 0xff3300));
                inventory.Magma = (inventory.Magma || 0) + 16;
                updateInventoryUI();
                updateHotbarUI();
                alert(`🌋 Lava Reverse Executed: Cleared ${countCleared} lava blocks and converted them to inventory magma!`);
            }
        }

        function onKeyDown(event) {
            if (event.code === 'Enter') {
                if (controls.isLocked) controls.unlock();
                document.getElementById('cheatPrompt').style.display = 'block';
                document.getElementById('cheatInput').focus();
                return;
            }

            if (event.code === 'KeyE') {
                toggleInventory();
                return;
            }

            if (isInventoryOpen) return;
            if (event.code === 'KeyT') { toggleDayNight(); return; }
            if (event.code === 'KeyQ') { drinkWater(); return; }

            if (controls.isLocked) {
                raycaster.setFromCamera(mouse, camera);
                let currentEquipped = hotbar[selectedSlotIndex];

                if (event.code === 'AltLeft') {
                    const animalIntersects = raycaster.intersectObjects(animals, true);
                    if (animalIntersects.length > 0) {
                        let hitAnimal = animalIntersects[0].object;
                        let rootGroup = hitAnimal;
                        while (rootGroup.parent && rootGroup.parent !== scene) {
                            rootGroup = rootGroup.parent;
                        }
                        scene.remove(rootGroup);
                        animals = animals.filter(a => a !== rootGroup);
                        
                        inventory.Porkchop = (inventory.Porkchop || 0) + 2;
                        addXP(35);
                        updateInventoryUI();
                        updateHotbarUI();
                        alert("🏹 Successful Hunt! Got Raw Porkchop and +35 XP!");
                        return;
                    }

                    const chestIntersects = raycaster.intersectObjects(chests, true);
                    if (chestIntersects.length > 0) {
                        let chest = chestIntersects[0].object;
                        if (!chest.userData.opened) {
                            chest.userData.opened = true;
                            inventory.Wood += 10;
                            inventory.Stone += 10;
                            inventory.Porkchop += 5;
                            alert("🎁 Bonus Chest Opened! Supplies added!");
                            updateInventoryUI();
                            updateHotbarUI();
                        } else {
                            alert("Chest is already empty!");
                        }
                        return;
                    }

                    const intersects = raycaster.intersectObjects(blocks);
                    if (intersects.length > 0) {
                        const targetBlock = intersects[0].object;
                        scene.remove(targetBlock);
                        blocks = blocks.filter(b => b !== targetBlock);
                        addXP(currentEquipped === 'Pickaxe' ? 20 : 10);
                        updateInventoryUI();
                        updateHotbarUI();
                    }
                    return;
                } else if (event.code === 'AltRight') {
                    let matIndex = -1;
                    if (currentEquipped === 'Grass') matIndex = 0;
                    else if (currentEquipped === 'Dirt') matIndex = 1;
                    else if (currentEquipped === 'Stone') matIndex = 2;
                    else if (currentEquipped === 'Magma') matIndex = 3;
                    else if (currentEquipped === 'Wood') matIndex = 4;
                    else if (currentEquipped === 'Leaves') matIndex = 5;
                    else if (currentEquipped === 'Wool') matIndex = 6;

                    if (matIndex !== -1 && inventory[currentEquipped] > 0) {
                        const intersects = raycaster.intersectObjects(blocks);
                        if (intersects.length > 0) {
                            const intersect = intersects[0];
                            const normal = intersect.face.normal;
                            const targetPos = intersect.object.position.clone().add(normal.clone().multiplyScalar(2));
                            createBlockAt(targetPos.x, targetPos.y, targetPos.z, matIndex);
                            inventory[currentEquipped]--;
                            addXP(5);
                            updateInventoryUI();
                            updateHotbarUI();
                        }
                    }
                    return;
                }
            }

            switch (event.code) {
                case 'KeyW': moveForward = true; break;
                case 'KeyS': moveBackward = true; break;
                case 'KeyA': moveLeft = true; break;
                case 'KeyD': moveRight = true; break;
                case 'Space':
                    if (canJump === true || isFlying) {
                        if (staminaLevel > 5) {
                            velocity.y += 11;
                            staminaLevel -= 4;
                            updateStatsUI();
                            canJump = false;
                        }
                    }
                    break;
                case 'Digit1': setHotbarSlot(0); break;
                case 'Digit2': setHotbarSlot(1); break;
                case 'Digit3': setHotbarSlot(2); break;
                case 'Digit4': setHotbarSlot(3); break;
                case 'Digit5': setHotbarSlot(4); break;
                case 'Digit6': setHotbarSlot(5); break;
            }
        }

        function onKeyUp(event) {
            switch (event.code) {
                case 'KeyW': moveForward = false; break;
                case 'KeyS': moveBackward = false; break;
                case 'KeyA': moveLeft = false; break;
                case 'KeyD': moveRight = false; break;
            }
        }

        function setHotbarSlot(index) {
            selectedSlotIndex = index;
            for (let i = 0; i < 6; i++) {
                const slotEl = document.getElementById(`hbSlot${i}`);
                if (i === index) slotEl.classList.add('active');
                else slotEl.classList.remove('active');
            }
            updateHeldItem();
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function checkCollision(pos) {
            if (isFlying) return false;
            const playerRadius = 0.5;
            const playerHeight = 2.0; 
            for (let i = 0; i < blocks.length; i++) {
                const b = blocks[i].position;
                if (
                    pos.x + playerRadius > b.x - 1 && pos.x - playerRadius < b.x + 1 &&
                    pos.y > b.y - 1 && pos.y - playerHeight < b.y + 1 &&
                    pos.z + playerRadius > b.z - 1 && pos.z - playerRadius < b.z + 1
                ) {
                    return true;
                }
            }
            return false;
        }

        function animate() {
            requestAnimationFrame(animate);

            const time = performance.now();
            const delta = (time - prevTime) / 1000;

            for (let i = 0; i < particles.length; i++) {
                let p = particles[i];
                p.position.y -= p.userData.speedY;
                p.rotation.x += p.userData.rotSpeed;
                if (p.position.y < 0) p.position.y = 40;
            }

            for (let i = 0; i < animals.length; i++) {
                let animal = animals[i];
                animal.userData.angle += (Math.random() - 0.5) * 0.5;
                animal.position.x += Math.cos(animal.userData.angle) * animal.userData.wanderSpeed * delta;
                animal.position.z += Math.sin(animal.userData.angle) * animal.userData.wanderSpeed * delta;
                animal.rotation.y = -animal.userData.angle + Math.PI / 2;
            }

            if (controls.isLocked === true && !isInventoryOpen) {
                if (!isFlying) velocity.y -= 9.8 * 8.0 * delta;
                else velocity.y = 0;

                const forwardVec = new THREE.Vector3();
                camera.getWorldDirection(forwardVec);
                forwardVec.y = 0;
                forwardVec.normalize();

                const sideVec = new THREE.Vector3(-forwardVec.z, 0, forwardVec.x);

                const moveDir = new THREE.Vector3();
                if (moveForward) moveDir.add(forwardVec);
                if (moveBackward) moveDir.sub(forwardVec);
                if (moveRight) moveDir.add(sideVec);
                if (moveLeft) moveDir.sub(sideVec);
                moveDir.normalize();

                const moveSpeed = 12.0;
                const objPos = controls.getObject().position;

                if (moveDir.lengthSq() > 0) {
                    staminaLevel = Math.max(0, staminaLevel - 0.6 * delta);
                    hungerLevel = Math.max(0, hungerLevel - 0.2 * delta);
                    updateStatsUI();
                }

                let nextX = objPos.x + moveDir.x * moveSpeed * delta;
                if (!checkCollision(new THREE.Vector3(nextX, objPos.y, objPos.z))) {
                    objPos.x = nextX;
                }

                let nextZ = objPos.z + moveDir.z * moveSpeed * delta;
                if (!checkCollision(new THREE.Vector3(objPos.x, objPos.y, nextZ))) {
                    objPos.z = nextZ;
                }

                let nextY = objPos.y + (isFlying ? 0 : (velocity.y * delta));
                if (!checkCollision(new THREE.Vector3(objPos.x, nextY, objPos.z))) {
                    objPos.y = nextY;
                    canJump = false;
                } else {
                    if (velocity.y < 0) canJump = true;
                    velocity.y = 0;
                }

                if (objPos.y < 6 && !isFlying) {
                    velocity.y = 0;
                    objPos.y = 6;
                    canJump = true;
                }
            }

            prevTime = time;
            renderer.render(scene, camera);
        }
    </script>
</body>
